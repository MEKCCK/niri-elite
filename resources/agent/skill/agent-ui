#!/usr/bin/env python3
"""List the controls of a window through its accessibility tree (AT-SPI), for the niri agent seat.

Prints one line per visible control: role, name, state, and the point to click in window
coordinates, the same coordinates `niri msg agent click --id N X Y` takes without --image.
Reading controls is faster and more exact than finding them in a screenshot, and it gives
text that's too small to read in an image.

Usage:
    agent-ui --id N [--all] [--find TEXT] [--json]

    --id N       window id from `niri msg -j windows`
    --find TEXT  only controls whose name, role or text contains TEXT (case-insensitive)
    --all        also list containers and unnamed text (panels, fillers, paragraphs)
    --json       one JSON object per line instead of text

Apps expose their tree only with accessibility on. GTK and Qt do by default. Firefox, Chromium
and Electron apps need it at start, which `agent-firefox` does; for Chromium and Electron, launch
with `env ACCESSIBILITY_ENABLED=1 app --force-renderer-accessibility`. Some apps (kitty, Alacritty,
games, most Wayland-only toolkits) have no tree at all; then this prints nothing useful and the
screenshot is the way.
"""

import argparse
import json
import os
import subprocess
import sys

import gi

gi.require_version("Atspi", "2.0")
from gi.repository import Atspi  # noqa: E402

NIRI = os.environ.get("NIRI", "niri")

# Roles worth listing even without a name.
INTERACTIVE = {
    "push button", "button", "toggle button", "check box", "radio button", "check menu item",
    "radio menu item", "menu item", "menu", "combo box", "entry", "password text", "text",
    "spin button", "slider", "link", "page tab", "list item", "table cell", "tree item",
    "scroll bar", "editbar", "toggle", "switch", "icon",
}
# Roles that are just structure.
CONTAINERS = {
    "application", "frame", "window", "panel", "filler", "scroll pane", "viewport", "section",
    "grouping", "layered pane", "split pane", "internal frame", "tool bar", "menu bar",
    "page tab list", "list", "table", "tree", "tree table", "redundant object", "unknown",
    "document frame", "document web", "form", "landmark", "block quote", "article",
}
STATES = [
    ("checked", Atspi.StateType.CHECKED),
    ("selected", Atspi.StateType.SELECTED),
    ("pressed", Atspi.StateType.PRESSED),
    ("expanded", Atspi.StateType.EXPANDED),
    ("focused", Atspi.StateType.FOCUSED),
]
MAX_NODES = 20000


def niri_info(window_id):
    out = subprocess.run(
        [NIRI, "msg", "agent", "info", "--id", str(window_id)],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        sys.exit(out.stderr.strip() or "niri msg agent info failed")
    return json.loads(out.stdout)


def find_app(pid):
    desktop = Atspi.get_desktop(0)
    for i in range(desktop.get_child_count()):
        app = desktop.get_child_at_index(i)
        if app is not None:
            try:
                if app.get_process_id() == pid:
                    return app
            except Exception:
                continue
    return None


def frames(app):
    for i in range(app.get_child_count()):
        child = app.get_child_at_index(i)
        if child is not None:
            yield child


def extents(obj):
    try:
        comp = obj.get_component_iface()
        if comp is None:
            return None
        e = comp.get_extents(Atspi.CoordType.WINDOW)
    except Exception:
        return None
    if e.width <= 0 or e.height <= 0 or e.x < -10000 or e.y < -10000:
        return None
    return (e.x, e.y, e.width, e.height)


def text_of(obj, role):
    if role not in ("entry", "text", "password text", "spin button", "combo box", "static"):
        return None
    try:
        t = obj.get_text_iface()
        if t is None:
            return None
        n = t.get_character_count()
        if role == "password text":
            return "•" * min(n, 8)
        return Atspi.Text.get_text(t, 0, min(n, 200))
    except Exception:
        return None


def value_of(obj):
    try:
        v = obj.get_value_iface()
        return None if v is None else v.get_current_value()
    except Exception:
        return None


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--id", type=int, required=True)
    parser.add_argument("--find")
    parser.add_argument("--all", action="store_true")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()

    info = niri_info(args.id)
    pid = info.get("pid")
    if pid is None:
        sys.exit("niri doesn't know the window's process")
    app = find_app(pid)
    if app is None:
        sys.exit(
            f"process {pid} has no accessibility tree; the app has accessibility off or doesn't "
            "support it. Use a screenshot."
        )

    ox, oy = info["surface_offset"]
    popups = info.get("popup_surfaces", [])
    w, h = info["size"]
    find = args.find.lower() if args.find else None

    # Each top-level accessible of the app is a window or a popup. Pick the one that matches
    # the niri window by size; popups come after it.
    roots = list(frames(app))
    main_root = None
    for root in roots:
        e = extents(root)
        if e and abs(e[2] - (w + 2 * ox)) <= 2 * ox + 2 and abs(e[3] - (h + 2 * oy)) <= 2 * oy + 2:
            try:
                if root.get_state_set().contains(Atspi.StateType.ACTIVE) or main_root is None:
                    main_root = root
            except Exception:
                main_root = root
    if main_root is None:
        main_root = roots[0] if roots else app

    count = 0
    lines = []

    def emit(obj, role, name, rect, origin, depth):
        x, y, rw, rh = rect
        cx = round(x + rw / 2 - origin[0], 1)
        cy = round(y + rh / 2 - origin[1], 1)
        if cx < -1 or cy < -1 or cx > w + 1 or cy > h + 1:
            return
        states = [label for label, st in STATES if obj.get_state_set().contains(st)]
        try:
            ss = obj.get_state_set()
            if not ss.contains(Atspi.StateType.ENABLED) and role in INTERACTIVE:
                states.append("disabled")
        except Exception:
            pass
        text = text_of(obj, role)
        if text and len(text) == 200:
            text += "…"
        value = value_of(obj)
        hay = " ".join(str(v) for v in (role, name, text or "") if v).lower()
        if find and find not in hay:
            return
        entry = {"role": role, "name": name, "x": cx, "y": cy, "w": rw, "h": rh}
        if states:
            entry["states"] = states
        if text not in (None, "", name) and not (name and text.rstrip("…") in name):
            entry["text"] = text
        if value is not None:
            entry["value"] = value
        lines.append((depth, entry))

    def walk(obj, origin, depth, in_popup):
        nonlocal count
        count += 1
        if count > MAX_NODES:
            return
        try:
            role = obj.get_role_name()
            name = (obj.get_name() or "").strip()
            ss = obj.get_state_set()
        except Exception:
            return
        if not ss.contains(Atspi.StateType.SHOWING) and role not in ("application",):
            return
        rect = extents(obj)

        # GTK 3 reports the items of an open menu relative to the menu's popup surface, whose
        # top-left corner niri reports in window coordinates.
        child_origin = origin
        # GTK 3 marks the menu whose submenu is open as selected rather than expanded.
        opened = ss.contains(Atspi.StateType.EXPANDED) or ss.contains(Atspi.StateType.SELECTED)
        if role == "menu" and popups and opened:
            px, py = popups[min(in_popup, len(popups) - 1)]
            child_origin = (-px, -py)
            in_popup += 1

        listed = rect is not None and (
            args.all
            or role in INTERACTIVE
            or (name and role not in CONTAINERS)
            or role == "static" and name
        )
        if listed:
            emit(obj, role, name, rect, origin, depth)

        # Nothing interesting below a text field or a link, besides its text.
        if role in ("entry", "password text", "link") and not args.all:
            return
        try:
            n = obj.get_child_count()
        except Exception:
            return
        for i in range(min(n, 2000)):
            child = obj.get_child_at_index(i)
            if child is not None:
                walk(child, child_origin, depth + 1, in_popup)

    # Coordinates from the surface origin to window coordinates.
    walk(main_root, (ox, oy), 0, 0)
    # Popups that are separate top-level accessibles (Chromium, Firefox) use their own surface.
    for root in roots:
        if root is main_root or not popups:
            continue
        e = extents(root)
        if e is None:
            continue
        px, py = popups[-1]
        walk(root, (-px, -py), 0, 1)

    if not lines:
        if find:
            sys.exit(f"no control matches {args.find!r}")
        sys.exit("the accessibility tree is empty; use a screenshot")

    for depth, e in lines:
        if args.json:
            print(json.dumps(e, ensure_ascii=False))
            continue
        extra = []
        if "states" in e:
            extra.append(",".join(e["states"]))
        if "text" in e:
            extra.append(f"text={e['text']!r}")
        if "value" in e:
            extra.append(f"value={e['value']:g}")
        name = f" {e['name']!r}" if e["name"] else ""
        tail = f" [{'; '.join(extra)}]" if extra else ""
        print(f"{e['role']}{name} @ {e['x']:g},{e['y']:g} ({e['w']}x{e['h']}){tail}")


if __name__ == "__main__":
    main()
