# Maintainer: MEKCCK <139054456+MEKCCK@users.noreply.github.com>

# niri-elite is a fork of niri that tracks upstream closely and adds grid
# overview, window minimization, the fullscreen magnifier, the liquid-glass
# background effect, a built-in xdg-desktop-portal backend and a native screen
# cast picker.
#
# It installs the same `niri` binary and session files as the `niri` package, so
# it conflicts with it (and with `niri-git`). Anything depending on `niri` is
# satisfied through `provides`.

pkgname=niri-elite-git
_pkgname=niri-elite
pkgver=r3287.gde17906
pkgrel=1
pkgdesc="Scrollable-tiling Wayland compositor (fork: grid overview, liquid glass, built-in portal)"
arch=(x86_64 aarch64)
url="https://github.com/MEKCCK/${_pkgname}"
license=(GPL-3.0-or-later)
depends=(
  cairo
  glib2
  libdisplay-info
  libinput
  libpipewire
  libxkbcommon
  mesa
  pango
  pixman
  seatd
  systemd-libs
)
makedepends=(clang git pkgconf rust)
optdepends=(
  'xwayland-satellite: run X11 applications'
  'xdg-desktop-portal: portal broker for the built-in ScreenCast/Screenshot backend'
  'xdg-desktop-portal-gtk: fallback portal for file chooser and friends'
  'oo7-portal: implements the Secret portal'
  'kitty: GPU-accelerated terminal emulator'
  'fuzzel: application launcher'
  'mako: notification daemon'
  'swaybg: wallpaper tool'
  'swaylock: screen locker'
  'polkit-gnome: authentication agent for privileged applications'
)
provides=("niri=$pkgver" wayland-compositor)
conflicts=(niri niri-git)
# Keep debug info: niri needs readable backtraces for crash reports, and its
# release profile only emits line tables, so stripping would leave `niri panic`
# useless.
options=(!strip)
source=("${_pkgname}::git+${url}.git#branch=main")
sha256sums=('SKIP')

pkgver() {
  cd "${_pkgname}"

  # This fork does not push upstream's release tags, so fall back to a plain
  # revision count when `git describe` cannot find a tag to describe from.
  if git describe --long --tags --abbrev=7 >/dev/null 2>&1; then
    git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf 'r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd "${_pkgname}"

  # Keep the crates inside srcdir instead of the build user's home.
  export CARGO_HOME="${srcdir}/${_pkgname}/.cargo"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${_pkgname}"

  export CARGO_HOME="${srcdir}/${_pkgname}/.cargo"
  export CARGO_TARGET_DIR=target

  # bindgen (used for the pipewire/SPA bindings) does not always find libclang
  # on its own; point it at the shared library explicitly.
  export LIBCLANG_PATH=/usr/lib

  # Show the actual commit in `niri --version` even though the build tree is a
  # worktree of the git clone.
  export NIRI_BUILD_COMMIT="$(git rev-parse --short HEAD)"

  # Do not use --all-features: some features are development-only (they enable
  # unbounded profiling buffers).
  cargo build --frozen --release
}

package() {
  cd "${_pkgname}"

  install -Dm755 "target/release/niri" -t "${pkgdir}/usr/bin/"
  install -Dm755 resources/niri-session -t "${pkgdir}/usr/bin/"

  install -Dm644 resources/niri.desktop -t "${pkgdir}/usr/share/wayland-sessions/"

  # The fork serves ScreenCast/Screenshot from its own portal backend, so it
  # ships both the portal definition and the portal configuration.
  install -Dm644 resources/niri.portal -t "${pkgdir}/usr/share/xdg-desktop-portal/"
  install -Dm644 resources/niri-portals.conf -t "${pkgdir}/usr/share/xdg-desktop-portal/"

  install -Dm644 resources/niri.service -t "${pkgdir}/usr/lib/systemd/user/"
  install -Dm644 resources/niri-shutdown.target -t "${pkgdir}/usr/lib/systemd/user/"

  install -Dm644 resources/default-config.kdl \
    "${pkgdir}/usr/share/doc/${pkgname}/default-config.kdl"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # Shell completions are generated by the binary itself.
  local shell
  for shell in bash fish zsh nushell; do
    "target/release/niri" completions "$shell" > "${srcdir}/niri.${shell}"
  done
  install -Dm644 "${srcdir}/niri.bash" \
    "${pkgdir}/usr/share/bash-completion/completions/niri"
  install -Dm644 "${srcdir}/niri.fish" \
    "${pkgdir}/usr/share/fish/vendor_completions.d/niri.fish"
  install -Dm644 "${srcdir}/niri.zsh" \
    "${pkgdir}/usr/share/zsh/site-functions/_niri"
  install -Dm644 "${srcdir}/niri.nushell" \
    "${pkgdir}/usr/share/nushell/completions/niri.nu"
}
